    70	    if grep -q '^RESULT .* 29$' "$resfile" 2>/dev/null; then stopped=quota; break; fi
    71	done
    72	wait
    73	
    74	while read -r tag name rc; do
    75	    [[ "$tag" == "RESULT" ]] || continue
    76	    if [[ "$rc" == "0" ]]; then ok=$((ok+1)); else failed=$((failed+1)); fi
    77	    [[ "$rc" == "29" ]] && stopped=quota
