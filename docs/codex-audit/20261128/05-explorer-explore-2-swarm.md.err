     1	#!/usr/bin/env bash
     2	# codex-swarm — держит N (максимум 5) процессов Codex в полёте, пока не кончатся атомы или квота.
     3	# Владелец 28.11: потолок 5 процессов на лида (AGENTS.md, PROCESS DISCIPLINE п.2), поэтому
     4	# «200000 штук» не запускаются: очередь из 200000 процессов = отказ машины, а не загрузка квоты.
     5	# Здесь квота выбирается плотно и безопасно: 5 в полёте постоянно, до rc=29 (квота кончилась).
     6	set -uo pipefail
     7	
     8	MAX_PARALLEL=5
     9	role=explorer
    10	project=$PWD
    11	out=""
    12	dry=0
    13	
    14	usage() {
    15	    cat <<'TXT'
    16	usage: codex-swarm <atoms-dir> [--role ROLE] [--project DIR] [--out DIR] [--parallel N] [--dry-run]
    17	
    18	Атомы: *.md в каталоге, каждый файл = один атом. Полёт: не более 5 процессов (жёсткий потолок).
    19	Остановка: rc=29 у любой роли (квота Codex исчерпана) — оставшаяся очередь не запускается.
    20	Итог: строка SWARM total=… ok=… failed=… stopped=quota|done.
    21	TXT
    22	}
    23	
    24	[[ $# -ge 1 ]] || { usage >&2; exit 2; }
    25	[[ "$1" == "--help" || "$1" == "-h" ]] && { usage; exit 0; }
    26	atoms=$1; shift
    27	[[ -d "$atoms" ]] || { echo "codex-swarm: нет каталога '$atoms'" >&2; exit 2; }
    28	
    29	while [[ $# -gt 0 ]]; do
    30	    case "$1" in
    31	        --role)     role=${2:?}; shift 2 ;;
    32	        --project)  project=${2:?}; shift 2 ;;
    33	        --out)      out=${2:?}; shift 2 ;;
    34	        --parallel) MAX_PARALLEL=${2:?}; shift 2 ;;
    35	        --dry-run)  dry=1; shift ;;
    36	        *) echo "codex-swarm: лишний аргумент '$1'" >&2; exit 2 ;;
    37	    esac
    38	done
    39	
    40	if (( MAX_PARALLEL > 5 )); then
    41	    echo "codex-swarm: отказ по правилу AGENTS.md (PROCESS DISCIPLINE п.2) — не более 5 процессов на лида, запрошено $MAX_PARALLEL" >&2
    42	    exit 2
    43	fi
    44	(( MAX_PARALLEL >= 1 )) || { echo "codex-swarm: --parallel >= 1" >&2; exit 2; }
    45	
    46	here=$(cd "$(dirname "$0")" && pwd)
    47	mapfile -t files < <(find "$atoms" -maxdepth 1 -type f -name '*.md' | sort)
    48	total=${#files[@]}
    49	(( total > 0 )) || { echo "codex-swarm: в '$atoms' нет *.md" >&2; exit 2; }
    50	
    51	if (( dry )); then
    52	    printf 'SWARM dry-run total=%s role=%s parallel=%s project=%s\n' "$total" "$role" "$MAX_PARALLEL" "$project"
    53	    printf '%s\n' "${files[@]}"
    54	    exit 0
    55	fi
    56	
    57	logdir=${out:-/root/workspaces/tools/docs/codex-audit/$(date +%Y%m%d)}
    58	mkdir -p "$logdir" || exit 2
    59	rolargs=("--project" "$project")
    60	[[ -n "$out" ]] && rolargs+=("--out" "$out")
    61	resfile=$logdir/swarm-results.txt
    62	: >"$resfile"
    63	
    64	ok=0; failed=0; stopped=done; inflight=0
