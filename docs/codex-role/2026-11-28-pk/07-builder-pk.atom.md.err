function writeEnvLines(string $path, array $extraLines): void
{
    file_put_contents($path, implode("\n", array_merge([
        'KINT_BASE_URL=https://kint.example.test/hs/KintAPI.hs',
        'KINT_USER=probe-user',
        "KINT_PASS=\"probe-pass\"",
    ], $extraLines, ['DB_PATH=/tmp/opencode/kint.sqlite'])) . "\n");
}

function writeEnv(string $path, string $webhookLine): void
{
    writeEnvLines($path, [$webhookLine]);
}

function configProbe(string $path): array
{
    try {
        $cfg = new KintB24\Config($path);
        return [$cfg->b24WebhookUrl(), $cfg->kintPass(), null];
    } catch (Throwable $e) {
        return [null, null, $e];
    }
        exit(1);
    }
}

