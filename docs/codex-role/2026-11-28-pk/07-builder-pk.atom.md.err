/**
 * Interval of the next tick: fast on activity or inside a peak window,
 * otherwise the current interval doubled up to the night or day ceiling.
 */
function loopNextInterval(
    int $current,
    bool $changed,
    \DateTimeImmutable $now,
    string $tz,
    string $peaks,
    int $maxDay,
    int $maxNight,
    string $nightFrom = '23:00',
    string $nightTo = '07:00'
): int {
    if ($changed || loopIsPeak($now, $tz, $peaks)) {
        return $current;
    }
    $ceiling = loopIsNight($now, $tz, $nightFrom, $nightTo) ? $maxNight : $maxDay;

    return min(max($current, 1) * 2, max($ceiling, 1));
}

/** Warmup day at startup: today during the day, null at night (the night sets it later). */
function loopWarmupStart(
    \DateTimeImmutable $now,
    string $tz,
    string $nightFrom,
    string $nightTo,
    int $warmupHour
): ?string {
