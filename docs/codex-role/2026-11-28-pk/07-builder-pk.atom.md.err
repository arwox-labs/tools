$interval    = $fastSec;
$lastChange  = $store->getState('sync:last_change');
$warmupDay   = loopWarmupStart(loopNow(), $tz, $nightFrom, $nightTo, $warmupHour);
$once        = (string)getenv('SYNC_LOOP_ONCE') === '1';

while (true) {
    $now     = loopNow();
    $night   = loopIsNight($now, $tz, $nightFrom, $nightTo);
    $peak    = loopIsPeak($now, $tz, $peakWindows);
    $warmup  = loopWarmupDue($warmupDay, $now, $tz, $nightFrom, $nightTo);
    $changes = 0;

    if ($warmup) {
        fwrite(STDOUT, '[loop] warmup ' . $now->format('c') . "\n");
        $warmupDay = null;
    }

    // A health skip is a failed tick, never data activity: it must not reset the
    // interval to fast.
    $changed = $lastChange !== null;
    try {
        $skip = false;
        foreach (['KINT' => fn(): bool => $health->kintAlive($cfg), 'B24' => fn(): bool => $health->b24Alive($cfg)] as $target => $probe) {
            if ($health->shouldSkip($store, $target) || !$probe()) {
                $health->recordFailure($store, $target);
                $skip = true;
                break;
            }
            $health->reset($store, $target);
        }

        if (!$skip) {
