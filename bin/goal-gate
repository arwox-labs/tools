#!/usr/bin/env bash
# goal-gate — Stop/PreToolUse-хук Claude Code: блокирует ✅ DONE с открытыми задачами и инструмент Agent (dcfg-86c43).
exec 2>/dev/null
case ${1-} in --help|-h) printf '%s\n' 'usage: goal-gate  (Claude Code hook: one hook JSON on stdin; PreToolUse Agent -> deny; Stop -> DONE with open tasks)'; exit 0;; esac
command -v jq >/dev/null || exit 0
json=$(cat) || exit 0
[ -n "$json" ] || exit 0
ev=$(jq -er '.hook_event_name | select(type == "string")' <<<"$json") || exit 0

if [ "$ev" = "PreToolUse" ]; then
  tool=$(jq -er '.tool_name // "" | select(type == "string")' <<<"$json") || exit 0
  [ "$tool" = "Agent" ] || exit 0
  jq -nc '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:"Agent tool is disabled; use /root/workspaces/tools/bin/code-channel auto|audit <worktree> <TZ>"}}'
  exit 0
fi
[ "$ev" = "Stop" ] || exit 0

msg=$(jq -er '(.last_assistant_message // "") | if type == "string" then . else error("m") end' <<<"$json") || exit 0
sid=$(jq -er '.session_id | select(type == "string" and length > 0)' <<<"$json") || exit 0
[[ $sid != *[/$'\n\r']* ]] || exit 0

plain=$(awk '/^[[:space:]]*```/{f=!f;next} !f{gsub(/`[^`]*`/,"");print}' <<<"$msg")

ctrl_re='^[[:space:]]*[*-]?[[:space:]]*Контроль задач:'
reason=''
if [[ $plain == *"✅ DONE"* ]]; then
  while IFS= read -r l; do
    [[ $l =~ $ctrl_re ]] || continue
    proc=0; open=0
    [[ $l =~ в[[:space:]]+процессе[[:space:]]*([0-9]+) ]] && proc=${BASH_REMATCH[1]}
    [[ $l =~ открыто[[:space:]]*([0-9]+) ]] && open=${BASH_REMATCH[1]}
    (( 10#$proc > 0 || 10#$open > 0 )) && reason="mark finished tasks completed in the session task list (or report PARTIAL) before ✅ DONE"
    break
  done <<<"$msg"
fi

file=/tmp/goal-gate-$sid
count=0
[ -e "$file" ] && { count=$(cat -- "$file" 2>/dev/null) || count=0; }
[[ $count =~ ^[0-9]+$ ]] || count=0
max=${GOAL_GATE_MAX:-2}
[[ $max =~ ^[0-9]+$ ]] || max=2

if [ -z "$reason" ]; then
  printf '0\n' >"$file" 2>/dev/null
  exit 0
fi
if (( 10#$count >= 10#$max )); then
  printf '0\n' >"$file" 2>/dev/null
  jq -nc --arg m "⛔ goal-gate: $reason" '{systemMessage:$m}'
  exit 0
fi
printf '%s\n' "$((10#$count + 1))" >"$file" 2>/dev/null
jq -nc --arg r "$reason" '{decision:"block",reason:$r}'
exit 0
