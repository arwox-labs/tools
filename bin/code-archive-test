   && [[ "$blocks53" == 0 ]] \
   && grep -qF 'ok:gitlab-rewritten refs/heads/feature-alert' "$T/log/code-archive.log" \
   && [[ -n "$rw53" ]] && grep -qF "$tip53" <<<"$rw53" \
   && [[ ! -f "$T/state/nonff53.rewritten" ]]; then
