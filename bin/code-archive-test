# Check 58: a real source carrying the reserved destination name would share the
# dot-github project with .github, so it fails closed: no local copy, no push,
# and the dot-github project keeps the .github content.
mkgh "dot-github"
git init -q "$T/l58"
git -C "$T/l58" config user.email t@t
git -C "$T/l58" config user.name t
git -C "$T/l58" checkout -q -b main
fixture_git -C "$T/l58" commit -q --allow-empty -m legacy
git -C "$T/l58" push -q "$T/github/dot-github.git" main
legacy58=$(git --git-dir="$T/github/dot-github.git" rev-parse main)
out58=$(env "${localenv[@]}" "${offline[@]}" "$bin/code-archive" dot-github 2>&1); rc58=$?
gl58=$(git --git-dir="$T/gitlab/dot-github.git" rev-parse refs/heads/main 2>/dev/null) || gl58=""
if [[ $rc58 == 1 ]] && grep -qF 'dot-github err:collision' <<<"$out58" \
   && [[ ! -e "$T/repos/dot-github.git" ]] \
   && [[ "$gl58" == "$gh57" ]] && [[ "$gl58" != "$legacy58" ]]; then
  p 58
else
  f 58
fi

# Reverse collision: the legacy destination predates the mapped source.
collision="$T/legacy-collision"
mkdir -p "$collision"/{gitlab,repos,state}
git clone -q --bare "$T/github/dot-github.git" "$collision/gitlab/dot-github.git"
git clone -q --bare "$T/github/dot-github.git" "$collision/repos/dot-github.git"
printf '%s\n' 2026-10-02T10:00:00Z > "$collision/state/dot-github.pushed_at"
before_collision=$(git --git-dir="$collision/gitlab/dot-github.git" show-ref)
out_collision=$(env "${localenv[@]}" "${offline[@]}" CA_REPOS_DIR="$collision/repos" \
  CA_GITLAB_BASE="$collision/gitlab" CA_STATE_DIR="$collision/state" "$bin/code-archive" .github 2>&1)
rc_collision=$?
if [[ "$rc_collision" == 1 && "$out_collision" == *'.github err:collision'* ]] \
  && [[ ! -e "$collision/repos/.github.git" ]] \
  && [[ "$(git --git-dir="$collision/gitlab/dot-github.git" show-ref)" == "$before_collision" ]]; then
  p destination-legacy-collision
else
  f destination-legacy-collision
fi

printf 'dot-github\t2026-10-02T10:00:00Z\t0\tfalse\n.github\t2026-10-02T10:00:00Z\t0\tfalse\n' > "$collision/list.tsv"
out_changed=$(env "${localenv[@]}" "${offline[@]}" CA_REPOS_DIR="$collision/repos" \
  CA_GITLAB_BASE="$collision/gitlab" CA_STATE_DIR="$collision/state" CA_LIST_FILE="$collision/list.tsv" \
  CA_DRILL_DOW=0 "$bin/code-archive" --changed 2>&1)
rc_changed=$?
out_case=$(env "${localenv[@]}" "${offline[@]}" "$bin/code-archive" Dot-GitHub 2>&1)
rc_case=$?
out_retry=$(env "${localenv[@]}" "${offline[@]}" "$bin/code-archive" .github 2>&1)
rc_retry=$?
if [[ $rc_changed == 1 && "$out_changed" == *'dot-github err:collision'* && "$out_changed" == *'.github err:collision'* ]] \
  && [[ $rc_case == 1 && "$out_case" == *'Dot-GitHub err:collision'* && $rc_retry == 0 ]] \
  && [[ "$(git --git-dir="$collision/gitlab/dot-github.git" show-ref)" == "$before_collision" ]]; then
  p destination-scheduled-and-retry
else
  f destination-scheduled-and-retry
fi

# Project API simulation. Git pushes are rewritten to a disposable bare
# repository. A lost creation response may leave a project that we cannot claim.
https_case="$T/ownership-https"
mkdir -p "$https_case"/{bin,gitlab,repos,state}
git init -q --bare "$https_case/gitlab/dot-github.git"
cat > "$https_case/bin/curl" <<'CURL'
#!/usr/bin/env bash
out="" method=GET
while (( $# )); do
  case "$1" in
    -o) out="$2"; shift;;
    -X) method="$2"; shift;;
    https://*) url="$1";;
  esac
  shift
done
code=200
case "$method:$url" in
  'GET:https://gitlab.example/api/v4/projects/group%2Fdot-github')
    if [[ -f "$MOCK_PROJECT" ]]; then
      body=$(cat "$MOCK_PROJECT")
    else code=404; body='{}'; fi;;
  'GET:https://gitlab.example/api/v4/groups/group') body='{"id":9}';;
  'POST:https://gitlab.example/api/v4/projects')
    body='{"id":17,"visibility":"private","http_url_to_repo":"https://gitlab.example/group/dot-github.git"}'
    printf '%s\n' "$body" > "$MOCK_PROJECT"; code=201;;
  */protected_branches) body='[{"name":"*"}]';;
  *) exit 1;;
esac
if [[ -n "$out" ]]; then
  printf '%s\n' "$body" > "$out"
else
  printf '%s\n' "$body"
fi
printf '%s' "$code"
if [[ "$method:$url" == POST:*/projects && "${MOCK_AMBIGUOUS:-0}" == 1 ]]; then exit 28; fi
CURL
cat > "$https_case/bin/gh" <<'GH'
#!/usr/bin/env bash
[[ "${*: -1}" == .id ]] || exit 1
printf '%s\n' "${MOCK_GITHUB_ID:-51}"
GH
chmod +x "$https_case/bin/"{curl,gh}
https_env=(PATH="$https_case/bin:$PATH" CA_GITHUB_BASE=https://github.com/fixture
  CA_GITLAB_BASE=https://gitlab.example/group CA_GITLAB_API=https://gitlab.example/api/v4
  CA_REPOS_DIR="$https_case/repos" CA_STATE_DIR="$https_case/state" MOCK_PROJECT="$https_case/project"
  GIT_CONFIG_COUNT=2 GIT_CONFIG_KEY_0="url.$T/github/.insteadOf" GIT_CONFIG_VALUE_0=https://github.com/fixture/
  GIT_CONFIG_KEY_1="url.$https_case/gitlab/.insteadOf" GIT_CONFIG_VALUE_1=https://gitlab.example/group/)
out_ambiguous=$(env "${localenv[@]}" "${https_env[@]}" MOCK_AMBIGUOUS=1 "$bin/code-archive" .github 2>&1)
rc_ambiguous=$?
out_existing=$(env "${localenv[@]}" "${https_env[@]}" "$bin/code-archive" .github 2>&1)
rc_existing=$?
if [[ $rc_ambiguous == 1 && $rc_existing == 1 && -f "$https_case/project" ]] \
  && [[ ! -e "$https_case/state/.github.destination" && ! -e "$https_case/repos/.github.git" ]] \
  && [[ -z "$(git --git-dir="$https_case/gitlab/dot-github.git" for-each-ref)" ]]; then
  p destination-https-unconfirmed
else
  f destination-https-unconfirmed
fi
mv "$https_case/project" "$https_case/ambiguous-project"
out_create=$(env "${localenv[@]}" "${https_env[@]}" "$bin/code-archive" .github 2>&1)
rc_create=$?
out_verified=$(env "${localenv[@]}" "${https_env[@]}" "$bin/code-archive" .github 2>&1)
rc_verified=$?
out_other_source=$(env "${localenv[@]}" "${https_env[@]}" MOCK_GITHUB_ID=52 "$bin/code-archive" .github 2>&1)
rc_other_source=$?
sed 's/"id":17/"id":18/' "$https_case/ambiguous-project" > "$https_case/project"
out_replaced=$(env "${localenv[@]}" "${https_env[@]}" "$bin/code-archive" .github 2>&1)
rc_replaced=$?
if [[ $rc_create == 0 && "$out_create" == *'.github ok:created'* && $rc_verified == 0 ]] \
  && [[ $rc_other_source == 1 && "$out_other_source" == *'err:collision'* ]] \
  && [[ $rc_replaced == 1 && "$out_replaced" == *'err:collision'* ]] \
  && [[ "$(git --git-dir="$https_case/gitlab/dot-github.git" rev-parse main)" == "$gh57" ]]; then
  p destination-https-identity
else
  f destination-https-identity
fi

# Check 59: a rewritten segment that is not exactly YYYYMMDD-HHMMSS is not the
# documented namespace, so the source ref stays missing.
mkgh "dateval59"
git -C "$T/seed" push -q "$T/github/dateval59.git" main
oid59=$(git --git-dir="$T/github/dateval59.git" rev-parse main)
git init -q --bare "$T/gitlab/dateval59.git"
seed_ref "$T/gitlab/dateval59.git" "$T/github/dateval59.git" "$oid59" refs/heads/rewritten/20260101-0000/main
pre59=$(git --git-dir="$T/gitlab/dateval59.git" rev-parse refs/heads/rewritten/20260101-0000/main 2>/dev/null) || pre59=""
git --git-dir="$T/gitlab/dateval59.git" config core.hooksPath "$T/gitlab/dateval59.git/hooks"
printf '#!/usr/bin/env bash\ngit --git-dir=%q update-ref -d refs/heads/main\n' "$T/gitlab/dateval59.git" > "$T/gitlab/dateval59.git/hooks/post-receive"
chmod +x "$T/gitlab/dateval59.git/hooks/post-receive"
out59=$(env "${localenv[@]}" "${offline[@]}" "$bin/code-archive" dateval59 2>&1); rc59=$?
if [[ $rc59 == 1 ]] && [[ "$pre59" == "$oid59" ]] \
   && grep -qF 'dateval59 err:incomplete layer=gitlab 1 missing' <<<"$out59"; then
  p 59
else
  f 59
fi

# Check 60: a nested branch server/main is satisfied by the dated rewritten ref
# that keeps the full leaf, so no second rewritten ref is written.
mkgh "nested60"
git init -q "$T/n60"
git -C "$T/n60" config user.email t@t
git -C "$T/n60" config user.name t
git -C "$T/n60" checkout -q -b server/main
fixture_git -C "$T/n60" commit -q --allow-empty -m one
git -C "$T/n60" push -q "$T/github/nested60.git" server/main
old60=$(git --git-dir="$T/github/nested60.git" rev-parse server/main)
git init -q --bare "$T/gitlab/nested60.git"
seed_ref "$T/gitlab/nested60.git" "$T/github/nested60.git" "$old60" refs/heads/server/main
fixture_git -C "$T/n60" commit -q --amend --allow-empty -m two
git -C "$T/n60" push -qf "$T/github/nested60.git" server/main
new60=$(git --git-dir="$T/github/nested60.git" rev-parse server/main)
seed_ref "$T/gitlab/nested60.git" "$T/n60/.git" "$new60" refs/heads/rewritten/20260101-000000/server/main
out60=$(env "${localenv[@]}" "${offline[@]}" "$bin/code-archive" nested60 2>&1); rc60=$?
cnt60=$(git --git-dir="$T/gitlab/nested60.git" for-each-ref refs/heads/rewritten/ --format='%(refname)' | wc -l)
obj60=$(git --git-dir="$T/gitlab/nested60.git" for-each-ref 'refs/heads/rewritten/*/server/main' --format='%(objectname)')
if [[ $rc60 == 0 ]] && [[ "$cnt60" == 1 ]] && [[ "$obj60" == "$new60" ]] \
   && grep -qF 'ok:gitlab-rewritten refs/heads/server/main' <<<"$out60"; then
  p 60
else
  f 60
fi

# Check 61: a rewritten ref that drops the nested part of the leaf does not stand
# in for server/main -> err:incomplete.
mkgh "nested61"
git init -q "$T/n61"
git -C "$T/n61" config user.email t@t
git -C "$T/n61" config user.name t
git -C "$T/n61" checkout -q -b server/main
fixture_git -C "$T/n61" commit -q --allow-empty -m one
git -C "$T/n61" push -q "$T/github/nested61.git" server/main
oid61=$(git --git-dir="$T/github/nested61.git" rev-parse server/main)
git init -q --bare "$T/gitlab/nested61.git"
seed_ref "$T/gitlab/nested61.git" "$T/github/nested61.git" "$oid61" refs/heads/rewritten/20260101-000000/main
pre61=$(git --git-dir="$T/gitlab/nested61.git" rev-parse refs/heads/rewritten/20260101-000000/main 2>/dev/null) || pre61=""
git --git-dir="$T/gitlab/nested61.git" config core.hooksPath "$T/gitlab/nested61.git/hooks"
printf '#!/usr/bin/env bash\ngit --git-dir=%q update-ref -d refs/heads/server/main\n' "$T/gitlab/nested61.git" > "$T/gitlab/nested61.git/hooks/post-receive"
chmod +x "$T/gitlab/nested61.git/hooks/post-receive"
out61=$(env "${localenv[@]}" "${offline[@]}" "$bin/code-archive" nested61 2>&1); rc61=$?
if [[ $rc61 == 1 ]] && [[ "$pre61" == "$oid61" ]] \
   && grep -qF 'nested61 err:incomplete layer=gitlab 1 missing' <<<"$out61"; then
  p 61
else
  f 61
fi

# Check 62: a nested tag rel/1.0 is satisfied by the dated rewritten ref that
# keeps the full leaf; the rejected tag tip stays untouched and no second
# rewritten ref is written.
mkgh "nested62"
git init -q "$T/n62"
git -C "$T/n62" config user.email t@t
git -C "$T/n62" config user.name t
git -C "$T/n62" checkout -q -b main
fixture_git -C "$T/n62" commit -q --allow-empty -m one
fixture_git -C "$T/n62" tag rel/1.0
git -C "$T/n62" push -q "$T/github/nested62.git" main rel/1.0
old62=$(git --git-dir="$T/github/nested62.git" rev-parse rel/1.0)
git init -q --bare "$T/gitlab/nested62.git"
seed_ref "$T/gitlab/nested62.git" "$T/github/nested62.git" "$old62" refs/tags/rel/1.0
fixture_git -C "$T/n62" commit -q --amend --allow-empty -m two
fixture_git -C "$T/n62" tag -f rel/1.0
git -C "$T/n62" push -qf "$T/github/nested62.git" rel/1.0
new62=$(git --git-dir="$T/github/nested62.git" rev-parse rel/1.0)
seed_ref "$T/gitlab/nested62.git" "$T/n62/.git" "$new62" refs/tags/rewritten/20260101-000000/rel/1.0
out62=$(env "${localenv[@]}" "${offline[@]}" "$bin/code-archive" nested62 2>&1); rc62=$?
cnt62=$(git --git-dir="$T/gitlab/nested62.git" for-each-ref refs/tags/rewritten/ --format='%(refname)' | wc -l)
obj62=$(git --git-dir="$T/gitlab/nested62.git" for-each-ref 'refs/tags/rewritten/*/rel/1.0' --format='%(objectname)')
tip62=$(git --git-dir="$T/gitlab/nested62.git" rev-parse refs/tags/rel/1.0 2>/dev/null) || tip62=""
if [[ $rc62 == 0 ]] && [[ "$cnt62" == 1 ]] && [[ "$obj62" == "$new62" ]] && [[ "$tip62" == "$old62" ]] \
   && grep -qF 'ok:gitlab-rewritten refs/tags/rel/1.0' <<<"$out62"; then
  p 62
else
  f 62
fi

echo "PASS $ok FAIL $((total-ok))"
[[ $ok == $total ]]
