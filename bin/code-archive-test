# Fixtures 54-62 need real objects in the GitLab repo: update-ref refuses to
# write an object the repo lacks, so each fixture ref is pushed there instead.
# A gh stub keeps owner discovery offline, so no fixture touches GitHub.
mkdir -p "$T/stuboffline"
printf '%s\n' '#!/usr/bin/env bash' 'exit 1' > "$T/stuboffline/gh"
chmod +x "$T/stuboffline/gh"
offline=(PATH="$T/stuboffline:$PATH")
seed_ref(){ git --git-dir="$2" push -q "$1" "$3:$4" 2>/dev/null; }

# Check 54: completeness is ref name + OID — a sibling ref holding the same
# object does not stand in for a ref the destination does not have.
mkgh "sibling54"
git -C "$T/seed" push -q "$T/github/sibling54.git" main
oid54=$(git --git-dir="$T/github/sibling54.git" rev-parse main)
git init -q --bare "$T/gitlab/sibling54.git"
seed_ref "$T/gitlab/sibling54.git" "$T/github/sibling54.git" "$oid54" refs/heads/server/main
sib54=$(git --git-dir="$T/gitlab/sibling54.git" rev-parse refs/heads/server/main 2>/dev/null) || sib54=""
git --git-dir="$T/gitlab/sibling54.git" config core.hooksPath "$T/gitlab/sibling54.git/hooks"
printf '#!/usr/bin/env bash\ngit --git-dir=%q update-ref -d refs/heads/main\n' "$T/gitlab/sibling54.git" > "$T/gitlab/sibling54.git/hooks/post-receive"
chmod +x "$T/gitlab/sibling54.git/hooks/post-receive"
out54=$(env "${localenv[@]}" "${offline[@]}" "$bin/code-archive" sibling54 2>&1); rc54=$?
if [[ $rc54 == 1 ]] && [[ "$sib54" == "$oid54" ]] \
   && grep -qF 'sibling54 err:incomplete layer=gitlab 1 missing' <<<"$out54"; then
  p 54
else
  f 54
fi

# Check 55: an unrelated rewritten archive name holding the same object does not
# suppress the rewritten ref of the rejected source ref.
mkgh "rewrite55"
git init -q "$T/rw55"
git -C "$T/rw55" config user.email t@t
git -C "$T/rw55" config user.name t
git -C "$T/rw55" checkout -q -b main
fixture_git -C "$T/rw55" commit -q --allow-empty -m one
git -C "$T/rw55" push -q "$T/github/rewrite55.git" main
old55=$(git --git-dir="$T/github/rewrite55.git" rev-parse main)
git init -q --bare "$T/gitlab/rewrite55.git"
seed_ref "$T/gitlab/rewrite55.git" "$T/rw55/.git" "$old55" refs/heads/main
fixture_git -C "$T/rw55" commit -q --amend --allow-empty -m two
git -C "$T/rw55" push -qf "$T/github/rewrite55.git" main
new55=$(git --git-dir="$T/github/rewrite55.git" rev-parse main)
seed_ref "$T/gitlab/rewrite55.git" "$T/rw55/.git" "$new55" refs/heads/rewritten/19990101-000000/other
out55=$(env "${localenv[@]}" "${offline[@]}" "$bin/code-archive" rewrite55 2>&1); rc55=$?
rw55=$(git --git-dir="$T/gitlab/rewrite55.git" for-each-ref 'refs/heads/rewritten/*/main' --format='%(objectname)')
other55=$(git --git-dir="$T/gitlab/rewrite55.git" rev-parse refs/heads/rewritten/19990101-000000/other 2>/dev/null) || other55=""
if [[ $rc55 == 0 ]] && [[ "$rw55" == "$new55" ]] && [[ "$other55" == "$new55" ]] \
   && grep -qF 'ok:gitlab-rewritten refs/heads/main' <<<"$out55"; then
  p 55
else
  f 55
fi

