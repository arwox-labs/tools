  "$root/bin/code-agent" go "$project" "$tz" --model arbitrary/model
for bad_allowed in null '"provider/model"' '[""]' '["provider"]' '["/model"]' '["provider/"]' '["provider/white space"]' '[7]'; do
  jq --argjson bad "$bad_allowed" '.ladder[0].allowed_models = $bad' "$go" >"$tmp/bad-allowed.json"
  CC_CONFIG=$tmp/bad-allowed.json check go_malformed_allowed_models_rejected '[[ $rc == 3 && $err == *"не читается"* && ! -s $log ]]' \
    "$root/bin/code-agent" go "$project" "$tz"
done
