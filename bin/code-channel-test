printf '%s\n' 99999999 >"$lock"
CC_CONFIG=$go check stale_lock_cleared '[[ $rc == 0 ]] && ! grep -Fq -- "worktree занят" "$tmp/err" && grep -q "^opencode " "$log" && [[ $(head -n1 "$lock") != 99999999 ]]' \
  env OPENCODE_RC=0 OPENCODE_TOUCH=stale-ok.txt SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-agent" go "$project" "$tz"
