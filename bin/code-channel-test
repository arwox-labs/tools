  env TEST_ONCE_DIR="$tmp/to-state" OPENCODE_RC=0 OPENCODE_TOUCH=tz-touched.txt SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-agent" go "$project" "$tztestfile"
