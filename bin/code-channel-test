  env TEST_ONCE_DIR="$tmp/to-and" OPENCODE_RC=0 OPENCODE_TOUCH=tz-and.txt SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-agent" go "$project" "$tzand"
git -C "$project" clean -fdq
rm -f -- "$tzcount"
CC_CONFIG=$go check tz_test_absent '[[ $rc == 0 && ! -s "$tzcount" ]] && ! grep -Fq -- "code-agent: test rc=" "$tmp/err"' \
  env OPENCODE_RC=0 OPENCODE_TOUCH=tz-none.txt SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-agent" go "$project" "$tz"
git -C "$project" clean -fdq
rm -f -- "$tzcount"
CC_CONFIG=$go check tz_test_prompt '[[ $rc == 0 ]] && grep -Fq -- "via /root/workspaces/tools/bin/test-once" "$log"' \
  env OPENCODE_RC=0 OPENCODE_TOUCH=tz-prompt.txt SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-agent" go "$project" "$tz"
git -C "$project" clean -fdq
tzstall=$tmp/tz-stall
printf '%s\n' 'test' "Test: $tztest" >"$tzstall"
pair=$(printf '%s\0' "$(realpath -- "$project")" bash -c "$tztest" | sha256sum | cut -d' ' -f1)
mkdir -p "$tmp/to-stall/fail"
printf '3\n%s\n' "$(date +%s)" >"$tmp/to-stall/fail/$pair"
CC_CONFIG=$go check tz_test_rc29 '[[ $rc == 29 ]] && grep -Fq -- "test rc=29" "$tmp/err"' \
  env TEST_ONCE_DIR="$tmp/to-stall" OPENCODE_RC=0 OPENCODE_TOUCH=tz-stall.txt SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-agent" go "$project" "$tzstall"
git -C "$project" clean -fdq
