  env OPENCODE_RC=1 OPENCODE_ERR='Error: Upstream request failed: test' SQLITE_SESSION_ID=session-123 SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-agent" go "$project" "$tz"

