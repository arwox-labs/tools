  env PATH="/root/.nvm/versions/node/v20.19.4/bin:$bin:/usr/local/bin:/usr/bin:/bin" SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-agent" go "$project" "$tz"
