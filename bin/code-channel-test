  env LOOP_PASS=1 CODE_CHANNEL_LOOP_LIMIT=5 PATH="$loopbin:$bin:$PATH" SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-agent" go "$project" "$tz"
((ok - lg0 == 3)) || { echo 'FAIL loop-guard'; ((fails++)); }

# Every control-path invocation uses isolated state and the test binaries.
export CODE_CHANNEL_STATE="$tmp/state"
for bad in '{"ladder":[]}' '{"ladder":[{"id":"go","enabled":true,"model":"x/y"}]}' '{"switch":{"channel":"sdk"},"ladder":[{"id":"sdk","enabled":true,"model":"x/y"},{"id":"go","enabled":false,"model":"x/z"}]}' '{"switch":{"channel":"go"},"ladder":[{"id":"go","enabled":false,"model":"x/y"}]}'; do
  printf '%s\n' "$bad" >"$tmp/invalid.json"
  CC_CONFIG=$tmp/invalid.json check invalid_config_plan '[[ $rc != 0 && ! -s $log ]]' "$root/bin/code-agent" --plan
  for form in auto audit delivery; do
    CC_CONFIG=$tmp/invalid.json check "invalid_config_$form" '[[ $rc != 0 && ! -s $log ]]' \
      "$root/bin/code-agent" "$form" "$project" "$tz"
  done
done
git -C "$project" clean -fdq
CC_CONFIG=$go check empty_auto_is_rejected '[[ $rc == 16 && $err == *"empty run"* ]]' \
  env SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-agent" auto "$project" "$tz"

rp_ok=0
rp_out=$(env -u CODE_CHANNEL_ACTIVE -u CODE_CHANNEL_CONFIG "$root/bin/code-agent" --plan 2>/dev/null); rp_rc=$?
[[ $rp_rc == 0 && -n $rp_out && $(wc -l <<<"$rp_out") == 1 ]] && ((rp_ok++))
((rp_ok == 1)) || { echo 'FAIL real-config-plan'; ((fails++)); }
rs_ok=0
rs_cfg=$(mktemp "$tmp/real-shape.XXXXXX")
jq '.switch = {channel: "go", owner_word: "работаем через OpenCode Go"} | .ladder |= map(.enabled = (.id == "go") | if .id == "go" then del(.owner_word) else . end)' "$root/config/code-channel.json" >"$rs_cfg"
rs_out=$(env -u CODE_CHANNEL_ACTIVE -u CODE_CHANNEL_TEST_LOG "CODE_CHANNEL_CONFIG=$rs_cfg" "$root/bin/code-agent" --plan 2>/dev/null); rs_rc=$?
[[ $rs_rc == 0 && $rs_out == go\ * ]] && ((rs_ok++))
((rs_ok == 1)) || { echo 'FAIL real-shape-plan'; ((fails++)); }

ladder_jq='([.ladder[].id] == ["go"]) and .ladder[0].enabled and .switch.channel == "go"'
check only_go_configured '[[ $rc == 0 ]]' jq -e "$ladder_jq" "$root/config/code-channel.json"
mcp_jq='(.mcp // {}) as $m | ((["codebase-memory-mcp","context7","repowise","vibecode"] - ($m | keys)) | length == 0) and ($m | all(.[]; .enabled == false))'
check go_no_mcp '[[ $rc == 0 ]] && jq -e "$mcp_jq" "$root/config/opencode-channel.json" >/dev/null' \
  jq -e . "$root/config/opencode-channel.json"
ext_jq='(.permission.external_directory["/tmp/**"] == "allow") and (.permission.external_directory["*"] == "deny")'
check go_external_deny_except_tmp '[[ $rc == 0 ]] && jq -e "$ext_jq" "$root/config/opencode-channel.json" >/dev/null' \
  jq -e . "$root/config/opencode-channel.json"
lean_jq='(.snapshot == false) and (.lsp == false) and (.autoupdate == false)'
CC_CONFIG=$go check go_lean_start '[[ $rc == 0 ]] && grep -Fq -- "--standalone run" "$log" && grep -Fxq -- "env OPENCODE_DISABLE_MODELS_FETCH=1" "$log" && grep -Fxq -- "env OPENCODE_DISABLE_AUTOUPDATE=1" "$log" && ! grep -Fq -- "env OPENCODE_DISABLE_CLAUDE_CODE=1" "$log" && jq -e "$lean_jq" "$root/config/opencode-channel.json" >/dev/null' \
  env OPENCODE_RC=0 SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-agent" go "$project" "$tz"

bans_cfg=$root/config/opencode-channel.json
bans_prompt=$(jq -er '.agent | select(.developer.prompt == .audit.prompt) | .developer.prompt' "$bans_cfg")
if [[ $bans_prompt =~ ^\{file:(.*)\}$ ]]; then
  bans_src=${BASH_REMATCH[1]}
  [[ $bans_src == /* ]] || bans_src=$(cd -- "$(dirname -- "$bans_cfg")" && pwd)/$bans_src
  bans_text=$(cat -- "$bans_src" 2>/dev/null) || bans_text=
else
  bans_text=$bans_prompt
fi
if [[ $bans_text == *"rm -rf"* && $bans_text == *"safe-delete"* ]]; then
  echo 'PASS go_bans_in_prompt'; ((ok++))
else
  echo "FAIL go_bans_in_prompt: prompt=$bans_prompt"; ((fails++))
fi

CC_CONFIG=$go check auto_provider_failure_no_handoff '[[ $rc == 1 && ! -e $tmp/forbidden-permit && $(grep -c "^opencode " "$log") == 1 ]] && ! grep -q "^sdk-agent " "$log"' \
  env OPENCODE_RC=1 CODE_CHANNEL_SDK_AGENT="$bin/sdk-agent-fake" CODE_CHANNEL_PERMIT="$tmp/forbidden-permit" SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-agent" auto "$project" "$tz"

if ((fails == 0)); then
  echo "PASS $ok checks"
  exit 0
fi
echo "FAIL $fails check(s); $ok passed"
exit 1
