check go_no_provider_mismatch '[[ $rc == 0 ]] && [[ $err != *"сверка провайдера не прошла"* ]]' \
  env SQLITE_RESULT='opencode-go|mimo-v2.6-flash' OPENCODE_TOUCH=go-change "$root/bin/code-agent" go "$project" "$root/AGENTS.md"
CC_CONFIG=$resume check go_timeout_retries_then_fail '[[ $rc == 124 && $(grep -c "^opencode " "$log") == 3 ]] && ! grep -q -- "--session" "$log" && grep -Fq -- "канал go недоступен" "$tmp/err"' \
  env OPENCODE_RC=124 SQLITE_SESSION_ID=session-123 SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-agent" go "$project" "$tz"
