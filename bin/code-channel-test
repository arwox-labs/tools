CC_CONFIG=$go check large_tz_stdin_go '[[ $rc == 0 && $(wc -c <"$stdin_go") -ge 200000 ]] && grep -Fq -- TAIL-PT2510 "$stdin_go" && [[ $(grep -m1 "^opencode " "$log" | wc -c) -lt 131072 ]]' \
  env OPENCODE_RC=0 OPENCODE_STDIN_COPY="$stdin_go" SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-agent" go "$project" "$tzbig"
CC_CONFIG=$goaudit check large_tz_stdin_audit '[[ $rc == 0 && $(wc -c <"$stdin_audit") -ge 200000 ]] && grep -Fq -- TAIL-PT2510 "$stdin_audit" && [[ $(grep -m1 "^opencode " "$log" | wc -c) -lt 131072 ]]' \
  env OPENCODE_STDIN_COPY="$stdin_audit" SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-agent" audit "$project" "$tzbig"
