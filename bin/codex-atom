#!/usr/bin/env bash
set -uo pipefail

usage() {
    printf '%s\n' \
        'usage: codex-atom <atom-file> [--project DIR] [--model M] [--read-only] [--dry-run]'
}

fail() {
    printf 'codex-atom: %s\n' "$*" >&2
}

if (($# < 1)); then
    usage >&2
    exit 2
fi

atom=$1
shift
project=$PWD
model=gpt-6-luna
read_only=0
dry_run=0

while (($#)); do
    case $1 in
        --project)
            (($# >= 2)) || { usage >&2; exit 2; }
            project=$2
            shift 2
            ;;
        --model)
            (($# >= 2)) || { usage >&2; exit 2; }
            model=$2
            shift 2
            ;;
        --read-only) read_only=1; shift ;;
        --dry-run) dry_run=1; shift ;;
        *) usage >&2; exit 2 ;;
    esac
done

[[ -f $atom && -s $atom ]] || { fail "atom-file missing or empty: $atom"; exit 2; }
atom=$(cd -- "$(dirname -- "$atom")" && pwd -P)/$(basename -- "$atom")
project=$(cd -- "$project" 2>/dev/null && pwd -P) || { fail "project directory unavailable"; exit 2; }

secrets=/root/workspaces/secrets
case $project in
    "$secrets"|"$secrets"/*) fail 'project cannot be inside secrets'; exit 2 ;;
esac
case $secrets in
    "$project"/*) fail 'project cannot make secrets writable'; exit 2 ;;
esac

# Beads workspace root: atoms live in the workspace tracker, not in a subproject repo.
WS=/root/workspaces/projects
[[ -d $WS/.beads ]] || WS=/root/workspaces/tools

sandbox=workspace-write
((read_only)) && sandbox=read-only

# F2: always run Codex with cwd = workspace so `bd`/Beads resolve the workspace tracker.
# The target repo is granted separately via --add-dir (read) and writable_roots (write).
cmd=(timeout 900 codex exec -m "$model" -c 'model_reasoning_effort="medium"' -s "$sandbox" --skip-git-repo-check --trust -C "$WS" -c 'sandbox_workspace_write.network_access=true')
if [[ $project != "$WS" ]]; then
    cmd+=(--add-dir "$project")
fi

if ((!read_only)); then
    roots=("$project" /tmp/opencode "$WS/.beads" "$WS/.agent-work" /root/workspaces/tools/.beads /root/workspaces/tools/state /root/.local/share/opencode/log)
    toml=""
    seen=":"
    for r in "${roots[@]}"; do
        [[ -d $r ]] || continue
        case $seen in *":$r:"*) continue ;; esac
        seen="$seen$r:"
        case $r in "$secrets"|"$secrets"/*) continue ;; esac
        esc=${r//\\/\\\\}
        esc=${esc//\"/\\\"}
        esc=${esc//$'\n'/\\n}
        esc=${esc//$'\r'/\\r}
        esc=${esc//$'\t'/\\t}
        toml+="${toml:+, }\"$esc\""
    done
    cmd+=(-c "sandbox_workspace_write.writable_roots=[$toml]")
fi
cmd+=(-)

if ((dry_run)); then
    printf '%q' "${cmd[0]}"
    for ((i = 1; i < ${#cmd[@]}; i++)); do
        printf ' %q' "${cmd[i]}"
    done
    printf ' < %q\n' "$atom"
    exit 0
fi

log_dir=/tmp/opencode/logs
mkdir -p -- "$log_dir" || { fail "cannot create log directory: $log_dir"; exit 3; }
log=$log_dir/codex-atom-$(date +%Y%m%dT%H%M%S%N).log
: >"$log" || { fail "cannot create log: $log"; exit 3; }
printf 'LOG: %s\n' "$log" >&2
"${cmd[@]}" <"$atom" 2>&1 | tee "$log"
pipe_status=("${PIPESTATUS[@]}")
rc=${pipe_status[0]}
# 28.11 ba-sanatory: `-o` убран (падал с `output path was replaced`); пустой вывод ловит
# проверка непустого файла вывода ниже.
tee_rc=${pipe_status[1]}

# F3: FALLBACK only on a real failure. rc!=0 is the primary signal; a few explicit
# fatal strings (quota / unsupported model / untrusted dir) also mean "could not act".
# Benign gate warnings like "workspace gate acquisition failed, continuing ungated" and
# "Dolt server unreachable ... continuing ungated" are NOT fatal — Codex still edits.
if ((rc != 0)) || grep -Eq 'Allocated quota exceeded|quota exceeded|model is not supported|not inside a trusted directory' "$log"; then
    printf 'FALLBACK: codex failed rc=%s\n' "$rc" >&2
    exit 29
fi
if ((tee_rc != 0)); then
    fail "cannot write log: $log"
    exit 3
fi
exit 0