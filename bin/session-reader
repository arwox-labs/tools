#!/usr/bin/env python3
"""Read-only access to selected OpenCode session metadata."""

import json
import os
import sqlite3
import sys


DATABASE = "/root/.local/share/opencode/opencode.db"
DATABASE_URI = "file:/root/.local/share/opencode/opencode.db?mode=ro"
FIELDS = "id, title, directory, tokens_input, tokens_cache_read, time_updated"


def usage():
    print("Usage: session-reader sessions [N] | session <id>", file=sys.stderr)
    return 2


def main(argv):
    if len(argv) < 2:
        return usage()

    command = argv[1]
    if command == "sessions":
        if len(argv) > 3:
            return usage()
        try:
            limit = int(argv[2]) if len(argv) == 3 else 15
            if limit < 0:
                raise ValueError
        except ValueError:
            print("session-reader: N must be a non-negative integer", file=sys.stderr)
            return 2
    elif command == "session":
        if len(argv) != 3 or not argv[2]:
            return usage()
    else:
        return usage()

    if not os.path.isfile(DATABASE):
        print(f"session-reader: database not found: {DATABASE}", file=sys.stderr)
        return 2

    try:
        connection = sqlite3.connect(DATABASE_URI, uri=True)
        connection.row_factory = sqlite3.Row
        connection.execute("PRAGMA query_only=ON")
        if command == "sessions":
            rows = connection.execute(
                f"SELECT {FIELDS} FROM session_v2 "
                "WHERE parent_id IS NULL OR parent_id = '' "
                "ORDER BY time_updated DESC LIMIT ?",
                (limit,),
            ).fetchall()
            result = [dict(row) for row in rows]
        else:
            row = connection.execute(
                f"SELECT {FIELDS} FROM session_v2 WHERE id = ? "
                "AND (parent_id IS NULL OR parent_id = '')",
                (argv[2],),
            ).fetchone()
            if row is None:
                print("session-reader: top-level session not found", file=sys.stderr)
                return 1
            result = dict(row)
        print(json.dumps(result, ensure_ascii=False))
        return 0
    except sqlite3.Error as error:
        print(f"session-reader: database error: {error}", file=sys.stderr)
        return 1
    finally:
        if "connection" in locals():
            connection.close()


if __name__ == "__main__":
    sys.exit(main(sys.argv))
