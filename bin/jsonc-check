#!/usr/bin/env python3
"""jsonc-check — валидация JSONC файла без node -e (реестр инструментов, строка 63).

usage: jsonc-check <file.jsonc> [...]
exit 0 — разобрано, 1 — ошибка разбора, 2 — ошибка вызова.
Полоса // комментариев и хвостовые запятые допускаются, как в opencode.jsonc.
"""
import json
import re
import sys


def strip_comments(text: str) -> str:
    out = []
    in_string = False
    escaped = False
    i = 0
    while i < len(text):
        ch = text[i]
        if in_string:
            out.append(ch)
            if escaped:
                escaped = False
            elif ch == "\\":
                escaped = True
            elif ch == '"':
                in_string = False
            i += 1
            continue
        if ch == '"':
            in_string = True
            out.append(ch)
            i += 1
            continue
        if ch == "/" and i + 1 < len(text) and text[i + 1] == "/":
            while i < len(text) and text[i] != "\n":
                i += 1
            continue
        if ch == "/" and i + 1 < len(text) and text[i + 1] == "*":
            end = text.find("*/", i + 2)
            i = len(text) if end == -1 else end + 2
            continue
        out.append(ch)
        i += 1
    return "".join(out)


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        print("usage: jsonc-check <file.jsonc> [...]", file=sys.stderr)
        return 2
    rc = 0
    for path in argv[1:]:
        try:
            with open(path, encoding="utf-8") as fh:
                raw = fh.read()
        except OSError as err:
            print(f"{path}: ERROR open: {err}", file=sys.stderr)
            rc = 1
            continue
        body = strip_comments(raw)
        body = re.sub(r",(\s*[}\]])", r"\1", body)  # хвостовые запятые
        try:
            json.loads(body)
        except json.JSONDecodeError as err:
            print(f"{path}: ERROR {err}", file=sys.stderr)
            rc = 1
            continue
        print(f"{path}: OK")
    return rc


if __name__ == "__main__":
    sys.exit(main(sys.argv))