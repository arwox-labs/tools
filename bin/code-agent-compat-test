#!/usr/bin/env bash
set -euo pipefail

root=$(cd -- "$(dirname -- "$0")/.." && pwd)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/code-agent-check.XXXXXX")
trap 'rm -rf -- "$tmp"' EXIT

[[ -f $root/bin/code-agent && ! -L $root/bin/code-agent ]] || {
  echo 'code-agent-compat-test: canonical entry must be a regular file' >&2
  exit 1
}

agent_help=$("$root/bin/code-agent" --help)
[[ $agent_help == *'usage: code-agent go '* ]]
agent_plan=$("$root/bin/code-agent" --plan)
[[ -n $agent_plan ]] || {
  echo 'code-agent-compat-test: canonical --plan returned empty output' >&2
  exit 1
}

ln -s "$root/bin/code-agent" "$tmp/code-agent"
alias_plan=$("$tmp/code-agent" --plan)
[[ $alias_plan == "$agent_plan" ]] || {
  echo 'code-agent-compat-test: PATH symlink resolved the wrong project root' >&2
  exit 1
}

mkdir -p "$tmp/bin"
printf '%s\n' '#!/usr/bin/env bash' ': >"$CODE_AGENT_PROVIDER_MARKER"' >"$tmp/bin/opencode"
chmod +x "$tmp/bin/opencode"

for args in '--help' '--plan' 'audit /missing /missing/tz.md' 'use go check'; do
  set +e
  PATH="$tmp/bin:$PATH" CODE_AGENT_PROVIDER_MARKER="$tmp/provider-ran" \
    "$root/bin/code-channel" $args >"$tmp/out" 2>"$tmp/err"
  status=$?
  set -e
  [[ $status == 64 && ! -s $tmp/out && ! -e $tmp/provider-ran && $(<"$tmp/err") == *'/root/workspaces/tools/bin/code-agent'* ]] || {
    echo "code-agent-compat-test: legacy entry did not fail closed for $args" >&2
    exit 1
  }
done

decision=$(jq -cn '{hook_event_name:"PreToolUse",tool_name:"Bash",tool_input:{command:"code-channel audit /x /y"}}' |
  LEAD_HINT_STRICT=1 "$root/bin/lead-hint")
[[ $(jq -r '.hookSpecificOutput.permissionDecision' <<<"$decision") == deny ]] || {
  echo 'code-agent-compat-test: lead guard allowed the retired entry' >&2
  exit 1
}

echo 'code-agent-compat-test: PASS (regular entry, plan, PATH symlink, legacy refusal, guard)'
