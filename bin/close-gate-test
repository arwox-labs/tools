#!/usr/bin/env bash
set -u

TOP="$(cd "$(dirname "$0")/.." && pwd)"
SANDBOX=$(mktemp -d /tmp/test-close-gate-XXXX) || exit 1
trap 'rm -rf "$SANDBOX"' EXIT
ORIGIN="$SANDBOX/origin.git"
REPO="$SANDBOX/clone"
mkdir "$SANDBOX/empty-hooks"
git init -q --bare --initial-branch=main "$ORIGIN"
git clone -q "$ORIGIN" "$REPO" 2>/dev/null
git -C "$REPO" config user.email test@example.com
git -C "$REPO" config user.name test
git -C "$REPO" config core.hooksPath "$SANDBOX/empty-hooks"
printf 'clean\n' > "$REPO/target.txt"
git -C "$REPO" add target.txt
git -C "$REPO" commit -q -m seed
git -C "$REPO" push -q -u origin main
ancestor=$(git -C "$REPO" rev-parse HEAD)
gate="$TOP/bin/close-gate"
PASS=0
FAIL=0

case_result() {
  if [[ $1 -eq 1 ]]; then
    PASS=$((PASS + 1))
    printf 'PASS %s\n' "$2"
  else
    FAIL=$((FAIL + 1))
    printf 'FAIL %s\n' "$2"
  fi
}

"$gate" --repo "$REPO" --paths target.txt >/dev/null 2>&1
rc=$?
case_result "$((rc == 0))" 'clean path rc=0'

printf 'dirty\n' > "$REPO/target.txt"
"$gate" --repo "$REPO" --paths target.txt >/dev/null 2>&1
rc=$?
case_result "$((rc == 1))" 'dirty path rc=1'
git -C "$REPO" checkout -q -- target.txt

"$gate" --repo "$REPO" --paths target.txt --commit "$ancestor" >/dev/null 2>&1
rc=$?
case_result "$((rc == 0))" 'ancestor commit rc=0'

git -C "$REPO" checkout -q --orphan orphan
git -C "$REPO" rm -q -rf .
printf 'orphan\n' > "$REPO/orphan.txt"
git -C "$REPO" add orphan.txt
git -C "$REPO" commit -q -m orphan
orphan=$(git -C "$REPO" rev-parse HEAD)
"$gate" --repo "$REPO" --paths target.txt --commit "$orphan" >/dev/null 2>&1
rc=$?
case_result "$((rc == 1))" 'orphan commit rc=1'

"$gate" --help >/dev/null 2>&1
rc=$?
case_result "$((rc == 0))" '--help rc=0'

"$gate" --repo "$SANDBOX/missing" --paths target.txt >/dev/null 2>&1
rc=$?
case_result "$((rc == 2))" 'missing repo path rc=2'

mkdir "$SANDBOX/not-a-repo"
output=$("$gate" --repo "$SANDBOX/not-a-repo" --paths target.txt 2>&1)
rc=$?
case_result "$((rc == 2))" 'non-repository path rc=2'
case_result "$([[ $output == *'is not a git repository'* ]] && echo 1 || echo 0)" 'non-repository message'

output=$("$gate" --repo "$REPO" --paths ':(invalid)' 2>&1)
rc=$?
case_result "$((rc == 2))" 'git status failure rc=2'
case_result "$([[ $output == *"close-gate: git status failed in $REPO"* ]] && echo 1 || echo 0)" 'git status failure message'

printf 'PASS %s/%s\n' "$PASS" "$((PASS + FAIL))"
((FAIL == 0))
