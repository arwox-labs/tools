#!/usr/bin/env bash
# codex-role — 12 ролей Codex конвейера (владелец 28.11).
# Одна роль = один изолированный процесс `codex exec` + один артефакт NN-<role>.md.
# Постоянное место артефактов: /root/workspaces/tools/docs/codex-audit/<date>/ (не /tmp).
set -uo pipefail

ELIGIBLE_ERR=29
OUT_ROOT=/root/workspaces/tools/docs/codex-audit/$(date +%Y%m%d)

usage() {
    cat <<'TXT'
usage: codex-role --list
       codex-role <role> <atom-file> [--project DIR] [--out DIR]

Роли (12): plan critic designer explorer analyst builder tester verifier
           reviewer integrator reporter guard

Артефакт: <out>/NN-<role>.md, на stdout — машинный отчёт строкой:
  RUNNER role=… model=… sandbox=… rc=… bytes=… atom_sha=… out=…
TXT
}

role_spec() {
    case "$1" in
        plan)       echo "gpt-6.2-astra high read-only 2" ;;
        critic)     echo "gpt-6.2-astra high read-only 3" ;;
        designer)   echo "gpt-6.2-astra high read-only 4" ;;
        explorer)   echo "gpt-6-luna low read-only 5" ;;
        analyst)    echo "gpt-6.2-astra high read-only 6" ;;
        builder)    echo "gpt-6-luna medium workspace-write 7" ;;
        tester)     echo "gpt-6-luna medium workspace-write 8" ;;
        verifier)   echo "gpt-6-luna low read-only 9" ;;
        reviewer)   echo "gpt-6.2-astra high read-only 10" ;;
        integrator) echo "gpt-6-luna medium workspace-write 11" ;;
        reporter)   echo "gpt-6-luna low read-only 12" ;;
        guard)      echo "gpt-6.2-astra high read-only 13" ;;
        *) return 1 ;;
    esac
}

list_roles() {
    printf '%-11s %-14s %-7s %-16s %s\n' ROLE MODEL EFFORT SANDBOX ORDER
    for r in plan critic designer explorer analyst builder tester verifier reviewer integrator reporter guard; do
        read -r m e s o <<<"$(role_spec "$r")"
        printf '%-11s %-14s %-7s %-16s %s\n' "$r" "$m" "$e" "$s" "$o"
    done
}

[[ $# -ge 1 ]] || { usage >&2; exit 2; }
if [[ "$1" == "--list" ]]; then list_roles; exit 0; fi
if [[ "$1" == "--help" || "$1" == "-h" ]]; then usage; exit 0; fi

role=$1; shift
spec=$(role_spec "$role") || { echo "codex-role: неизвестная роль '$role'" >&2; usage >&2; exit 2; }
read -r model effort sandbox order <<<"$spec"

[[ $# -ge 1 ]] || { echo "codex-role: нужен atom-file" >&2; exit 2; }
atom=$1; shift
[[ -r "$atom" ]] || { echo "codex-role: нет файла '$atom'" >&2; exit 2; }

project=$PWD
out=$OUT_ROOT
while [[ $# -gt 0 ]]; do
    case "$1" in
        --project) project=${2:?}; shift 2 ;;
        --out)     out=${2:?}; shift 2 ;;
        *) echo "codex-role: лишний аргумент '$1'" >&2; exit 2 ;;
    esac
done

# Постоянное место артефактов: /tmp запрещён владельцем 28.11.
case "$out" in
    /tmp/*) echo "codex-role: отказ по правилу владельца — артефакты не в /tmp, а в tools/docs" >&2; exit 2 ;;
esac

command -v codex >/dev/null || { echo "codex-role: codex не найден в PATH" >&2; exit 29; }
mkdir -p "$out" || exit 2
[[ -d "$project" ]] || { echo "codex-role: нет каталога проекта '$project'" >&2; exit 2; }

artifact=$out/$(printf '%02d' "$order")-$role-$(basename "${atom%.md}").md
atom_sha=$(sha256sum "$atom" | awk '{print $1}')
runner_sha=$(sha256sum "$0" | awk '{print $1}')
timeout_s=$([[ "$sandbox" == "read-only" ]] && echo 300 || echo 1800)

prompt=$(cat "$atom")
prompt+=$'\n\nКниговодство ведёт лид: не вызывай bd, не создавай Goal, не запускай git-команды. Атом уже создан и закреплён за тобой, он указан в тексте задания. Пиши только перечисленные в задании файлы. Текстовый отказ без правок считается провалом атома.'
prompt+=$'\n\nНавыки и плагины не подключай: работай только по тексту этого задания. Если навык или правило ссылается на отсутствующий файл, это не повод останавливаться — выполни задание и упомяни отсутствие одной строкой в конце.'
# В read-only контуре внутренний инструмент чтения Codex может быть недоступен —
# тогда роль обязана читать файлы через shell, иначе артефакт будет пустым отказом.
if [[ "$sandbox" == "read-only" ]]; then
    prompt+=$'\n\nФайлы читай через shell: sed -n "1,200p" <path> или cat <path>. Если инструмент чтения файлов отказывает, это не повод отказываться: читай shell-командой.'
fi
if [[ ${CODEX_ROLE_SNAPSHOT:-} != "$runner_sha" ]]; then
    snapshot=$(mktemp "$out/.runner-$runner_sha.XXXXXX.sh") || exit 2
    cp -f "$0" "$snapshot" && chmod +x "$snapshot" || { rm -f "$snapshot"; exit 2; }
    CODEX_ROLE_SNAPSHOT=$runner_sha bash "$snapshot" "$role" "$atom" --project "$project" --out "$out"
    exit $?
fi
snapshot=$0
before=$(git -C "$project" status --porcelain --untracked-files=no 2>/dev/null | sha256sum | awk '{print $1}')
setsid timeout "$timeout_s" codex exec -m "$model" -c model_reasoning_effort="$effort" \
    -c 'sandbox_workspace_write.network_access=true' \
    -c "sandbox_workspace_write.writable_roots=[\"$project\",\"$project/.agent-work\",\"/root/workspaces/projects/.beads\",\"/root/workspaces/tools/.beads\",\"/root/workspaces/tools/docs\",\"/root/workspaces/tools/state\",\"/root/.local/share/opencode/log\"]" \
    -s "$sandbox" --skip-git-repo-check -C "$project" "$prompt" \
    </dev/null >"$artifact" 2>"$artifact.err" &
pgid=$!
wait $pgid; rc=$?
after=$(git -C "$project" status --porcelain --untracked-files=no 2>/dev/null | sha256sum | awk '{print $1}')
if [[ $rc -eq 124 ]]; then
    kill -TERM -$pgid 2>/dev/null || true
    sleep 5
    kill -KILL -$pgid 2>/dev/null || true
fi
rm -f "$snapshot"
# 28.11 ba-sanatory: `-o/--output-last-message` убран — он падает с
# `Error: Failed to write last message file ... output path was replaced` и теряет готовый ответ.
# Guard пустого ответа — проверка непустого "$artifact" ниже.

bytes=$(wc -c <"$artifact" 2>/dev/null || echo 0)
if [[ $rc -eq 124 ]]; then
    printf 'RUNNER role=%s model=%s sandbox=%s rc=124 partial=%s atom_sha=%s runner_sha=%s out=%s\n' \
        "$role" "$model" "$sandbox" "$bytes" "$atom_sha" "$runner_sha" "$artifact"
    head -3 "$artifact.err" >&2
    exit 124
fi
if [[ $rc -ne 0 ]]; then
    printf 'RUNNER role=%s model=%s sandbox=%s rc=%s bytes=%s atom_sha=%s runner_sha=%s out=%s err=%s\n' \
        "$role" "$model" "$sandbox" "$rc" "$bytes" "$atom_sha" "$runner_sha" "$artifact" "$artifact.err"
    head -3 "$artifact.err" >&2
    exit "$rc"
fi
if [[ $rc -eq 0 && $sandbox == workspace-write && $before == $after ]]; then
    printf 'RUNNER role=%s model=%s sandbox=%s rc=1 bytes=%s atom_sha=%s runner_sha=%s out=%s nochange=1\n' \
        "$role" "$model" "$sandbox" "$bytes" "$atom_sha" "$runner_sha" "$artifact"
    exit 1
fi
if [[ ! -s "$artifact" ]]; then
    printf 'RUNNER role=%s model=%s sandbox=%s rc=%s bytes=0 atom_sha=%s runner_sha=%s out=%s empty=1\n' \
        "$role" "$model" "$sandbox" 1 "$atom_sha" "$runner_sha" "$artifact"
    exit 1
fi
if [[ $sandbox == read-only ]] && grep -qiE 'Не могу|^[[:space:]]*Остановился|не могу менять|read-only file system|^[[:space:]]*Отказ' "$artifact"; then
    printf 'RUNNER role=%s model=%s sandbox=%s rc=1 bytes=%s atom_sha=%s runner_sha=%s out=%s refusal=1\n' \
        "$role" "$model" "$sandbox" "$bytes" "$atom_sha" "$runner_sha" "$artifact"
    exit 1
fi
printf 'RUNNER role=%s model=%s sandbox=%s rc=0 bytes=%s atom_sha=%s runner_sha=%s out=%s\n' \
    "$role" "$model" "$sandbox" "$bytes" "$atom_sha" "$runner_sha" "$artifact"
