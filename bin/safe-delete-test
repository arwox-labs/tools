out118=$(SAFE_DELETE_SANDBOX="$d/sb" "$bin/safe-delete" --bk "$bk" dir "$d/sb/arwox-clone-$$" 2>&1); r118=$?
gone118=0; [[ ! -e "$d/sb/arwox-clone-$$" ]] && gone118=1
