# T84: one call deletes 1000 files; restore ids from lines 1, 500, 1000 bring back their content
mkdir -p "$d/bench"
seq 1 1000 | split -d -l 1 -a 4 - "$d/bench/f"
t84s=$(date +%s%N)
out84=$("$bin/safe-delete" --bk "$bk" file "$d"/bench/f* 2>/dev/null); r84=$?
t84e=$(date +%s%N)
ms84=$(( (t84e - t84s) / 1000000 ))
n84=$(grep -c '^удалено: ' <<< "$out84")
left84=$(find "$d/bench" -type f | wc -l)
rr84=0; good84=0
while IFS= read -r line; do
  p84=$(sed 's/^удалено: //; s/ |.*//' <<< "$line")
  id84=$(awk '{print $NF}' <<< "$line")
  exp84=$(( 10#${p84##*/f} + 1 ))
  "$bin/safe-delete" --bk "$bk" restore "$id84" >/dev/null 2>&1 || rr84=1
  [[ -f $p84 && $(cat "$p84") == "$exp84" ]] && good84=$((good84+1))
done < <(sed -n '1p;500p;1000p' <<< "$out84")
if [[ $r84 == 0 && $n84 == 1000 && $left84 == 0 && $ms84 -le 5000 && $rr84 == 0 && $good84 == 3 ]]; then
  echo 'PASS T84 batch_1000'; ok=$((ok+1))
else echo "FAIL T84: rc=$r84 n=$n84 left=$left84 ms=$ms84 rr=$rr84 good=$good84"; fi

