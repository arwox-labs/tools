l118=$(awk -F '\t' -v p="$d/sb/arwox-clone-$$/a.txt" '$2 == "file" && $3 == p && $8 == "deleted" { n=NR } END { print n }' "$bk/ledger.tsv")
r118b=1
if [[ -n $l118 ]]; then "$bin/safe-delete" --bk "$bk" restore "$l118" >/dev/null 2>&1; r118b=$?; fi
c118=$(cat "$d/sb/arwox-clone-$$/a.txt" 2>/dev/null)
if [[ $r118 == 0 && $gone118 == 1 && $g118 == 0 && $r118b == 0 && $c118 == c ]]; then echo 'PASS T118 sandbox_any_name_clone'; ok=$((ok+1)); else echo "FAIL T118: rc=$r118 gone=$gone118 line=$l118 git=$g118 restore=$r118b c=$c118"; fi

