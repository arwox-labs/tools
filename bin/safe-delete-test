# T130: codex/* merged into origin/<base> (--no-ff, pushed) is deletable, gone locally
git -C "$d/w" checkout -q -b main 2>/dev/null || git -C "$d/w" checkout -q main
git -C "$d/w" commit -q --allow-empty -m "chore(sdtest): base"
