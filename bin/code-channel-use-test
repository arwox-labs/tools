#!/usr/bin/env bash
set -eu

root=$(cd -- "$(dirname -- "$0")/.." && pwd)
state=$(mktemp -d "${TMPDIR:-/tmp}/code-channel-use.XXXXXX")
trap 'rm -rf -- "$state"' EXIT
run() { env -u CODE_CHANNEL_ACTIVE CODE_CHANNEL_CONFIG="$root/config/code-channel.json" CODE_CHANNEL_STATE="$state" "$root/bin/code-channel" "$@"; }

[[ $(run use go 'test quote') == active=go ]]
plan=$(run --plan)
[[ $plan == 'go '* ]]
log=$(<"$state/use.log")
for args in sdk nope; do
    if run use "$args" 'test quote'; then exit 1; fi
done
if run use go; then exit 1; fi
[[ $(<"$state/active") == go && $(<"$state/use.log") == "$log" ]]
printf '%s\n' sdk > "$state/active"
[[ $(run --plan) == "$plan" ]]
echo 'PASS use go, invalid switches preserve state and log, stale state resolves to go'
