#!/bin/sh
# AUTO-GITHUB entry point 1 of 2 (owner 08.11). The push logic itself lives in ONE file, auto-push.sh,
# because the same guarantee is needed by the shared dispatcher entry point 2. No second copy exists.
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -n "$ROOT" ] || exit 0
/root/workspaces/projects/.githooks/auto-push.sh
( setsid nice -n 19 /root/workspaces/tools/bin/code-memory-enable "$ROOT" >>/tmp/code-memory.log 2>&1 & ) # code-memory-hook
exit 0
